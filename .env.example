# Copy privately to .env.local or enter in your own Vercel project.
# Provider: configure one or more.
OPENROUTER_API_KEY=
# NVIDIA_API_KEY=
# OPENAI_API_KEY=
VIBEAGENT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Your own Redis REST storage: required for hosted scans.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Generate independent random values at least 32 characters long.
VIBE_AGENT_API_TOKEN=
VIBE_AGENT_WORKSPACE_TOKEN=
VIBE_AGENT_VERIFICATION_SECRET=
VIBE_AGENT_QUEUE_ENABLED=0
VIBE_AGENT_REQUIRE_OWNERSHIP=1
