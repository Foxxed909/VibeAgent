{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    { "source": "/api/scan", "destination": "/api/index?route=scan" },
    { "source": "/api/job", "destination": "/api/index?route=job" },
    { "source": "/api/waitlist", "destination": "/api/index?route=waitlist" },
    { "source": "/api", "destination": "/api/index" }
  ]
}
